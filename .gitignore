# ── Secrets ──────────────────────────────────────────────
.env
*.pem
*.key

# ── Personal / generated configuration ────────────────────
# Commit only the *.example.yaml templates.
config/config.yaml
config/knowledge-base.yaml
config/kb_suggestions/*.yaml

# ── Generated output ──────────────────────────────────────
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep
scripts/run_review.bat

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node / MCP server ─────────────────────────────────────
mcp/node_modules/
mcp/dist/
npm-debug.log*

# ── RAG service (local vector store + ingestion dumps) ────
# The index may hold client-confidential docs — never commit it.
rag/.data/
rag/*.db
rag/docs*.json
rag/*.local.json

# ── OS / editor ───────────────────────────────────────────
.DS_Store
__MACOSX/
*.swp
